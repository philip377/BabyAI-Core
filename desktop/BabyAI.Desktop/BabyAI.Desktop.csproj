<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>BabyAI.Desktop</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.1.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.3.1" />
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.4.1" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="org.k2fsa.sherpa.onnx" Version="1.13.5" />
  </ItemGroup>

  <Target Name="CopyLooseXamlResourcesAfterPublish"
          AfterTargets="Publish"
          Condition="'$(WindowsPackageType)' == 'None' and '$(PublishSingleFile)' != 'true'">
    <ItemGroup>
      <_BabyAILooseXamlResource Include="$(TargetDir)*.xbf" />
      <_BabyAILooseXamlResource Include="$(TargetDir)$(AssemblyName).pri"
                                Condition="Exists('$(TargetDir)$(AssemblyName).pri')" />
    </ItemGroup>
    <Error Condition="'@(_BabyAILooseXamlResource)' == ''"
           Text="Loose WinUI XAML resources were not produced; Windows 10 publish would be unusable." />
    <Copy SourceFiles="@(_BabyAILooseXamlResource)"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true" />
  </Target>

  <!-- Diagnostic branch only: keep #134 untouched while the owner compares the
       exact same in-memory PCM with Whisper Tiny and Base. Release publish gets
       the Base int8 files automatically; normal build does not download models. -->
  <Target Name="BundleExperimentalSttBaseAfterPublish"
          AfterTargets="Publish"
          Condition="'$(RuntimeIdentifier)' == 'win-x64' and '$(Configuration)' == 'Release'">
    <Exec Command="pwsh -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\scripts\windows\prepare-stt-ab-base.ps1&quot; -PublishDir &quot;$(PublishDir)&quot;" />
  </Target>
</Project>
