<Window
    x:Class="BabyAI.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BabyAI.Desktop">

    <Grid x:Name="Root" Background="Transparent" Padding="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition x:Name="PanelColumn" Width="0" />
        </Grid.ColumnDefinitions>

        <Button x:Name="OrbButton"
                Grid.Column="0"
                Width="112"
                Height="112"
                CornerRadius="56"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Click="OrbButton_Click"
                PointerPressed="OrbButton_PointerPressed"
                PointerMoved="OrbButton_PointerMoved"
                PointerReleased="OrbButton_PointerReleased"
                Padding="0"
                BorderThickness="1">
            <Grid>
                <Ellipse x:Name="OrbGlow" Width="104" Height="104" Opacity="0.28" Fill="#7C8DFF" />
                <Ellipse x:Name="OrbCore" Width="88" Height="88" Opacity="0.92" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <ScaleTransform x:Name="OrbScale" ScaleX="1" ScaleY="1" />
                    </Ellipse.RenderTransform>
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop x:Name="CenterStop" Color="#FFF7F9FF" Offset="0" />
                            <GradientStop x:Name="MidStop" Color="#FFB8C8FF" Offset="0.55" />
                            <GradientStop x:Name="EdgeStop" Color="#FF6D7CFF" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse x:Name="OrbRing" Width="54" Height="54" StrokeThickness="2" Stroke="#BFFFFFFF" Opacity="0.9" />
                <TextBlock x:Name="StateGlyph"
                           Text="•"
                           FontSize="34"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="White" />
            </Grid>
        </Button>

        <Border x:Name="Panel"
                Grid.Column="1"
                Width="0"
                Height="420"
                Margin="12,0,0,0"
                CornerRadius="28"
                Background="#A8171B27"
                BorderBrush="#42FFFFFF"
                BorderThickness="1"
                Opacity="0"
                Visibility="Collapsed">
            <Border.Transitions>
                <TransitionCollection>
                    <RepositionThemeTransition />
                </TransitionCollection>
            </Border.Transitions>
            <Grid Padding="20" RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Spacing="2">
                    <TextBlock x:Name="IdentityText" Text="BabyAI" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock x:Name="TaskText" Text="No active task" Opacity="0.65" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock x:Name="CoreStatusText" Text="Core: not checked" FontSize="12" Opacity="0.5" />
                        <TextBlock x:Name="RuntimeText" Text="Runtime: unknown" FontSize="12" Opacity="0.5" />
                    </StackPanel>
                    <local:BrainStatusIndicator x:Name="BrainText"
                                                Text="Brain: checking…"
                                                FontSize="12"
                                                Opacity="0.72"
                                                TextWrapping="Wrap" />
                </StackPanel>

                <Border Grid.Row="1" Background="#22FFFFFF" CornerRadius="14" Padding="10">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ReplyText" Grid.Column="0" Text="Ready." TextWrapping="Wrap" FontSize="12" />
                        <Button x:Name="RetryButton"
                                Grid.Column="1"
                                Content="Retry Core"
                                Click="RetryButton_Click"
                                Visibility="Collapsed" />
                    </Grid>
                </Border>

                <Border Grid.Row="2" Background="#16FFFFFF" CornerRadius="16" Padding="12">
                    <ScrollViewer x:Name="ConversationScroller"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <TextBlock x:Name="ConversationText"
                                   Text="Чат готов. Напиши первое сообщение ниже."
                                   TextWrapping="Wrap"
                                   IsTextSelectionEnabled="True" />
                    </ScrollViewer>
                </Border>

                <TextBox x:Name="MessageBox"
                         Grid.Row="3"
                         PlaceholderText="Напиши BabyAI..."
                         AcceptsReturn="True"
                         MinHeight="62"
                         MaxHeight="92"
                         TextWrapping="Wrap"
                         KeyDown="MessageBox_KeyDown" />

                <Grid Grid.Row="4" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="SendButton" Grid.Column="0" Content="Send" Click="SendButton_Click" />
                    <Button x:Name="StopButton" Grid.Column="1" Content="Stop" Click="StopButton_Click" Visibility="Collapsed" />
                    <Button x:Name="ApproveButton" Grid.Column="2" Content="Approve" Click="ApproveButton_Click" Visibility="Collapsed" />
                    <Button x:Name="RejectButton" Grid.Column="3" Content="Reject" Click="RejectButton_Click" Visibility="Collapsed" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
