<Window
    x:Class="BabyAI.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="Root" Background="Transparent" Padding="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition x:Name="PanelColumn" Width="0" />
        </Grid.ColumnDefinitions>

        <Button x:Name="OrbButton"
                Grid.Column="0"
                Width="112"
                Height="112"
                CornerRadius="56"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Click="OrbButton_Click"
                PointerPressed="OrbButton_PointerPressed"
                PointerMoved="OrbButton_PointerMoved"
                PointerReleased="OrbButton_PointerReleased"
                Padding="0"
                Background="Transparent"
                BorderBrush="#32FFFFFF"
                BorderThickness="1">
            <Grid>
                <Ellipse Width="110"
                         Height="110"
                         Stroke="#20FFFFFF"
                         StrokeThickness="1" />
                <Ellipse x:Name="OrbGlow"
                         Width="104"
                         Height="104"
                         Opacity="0.28"
                         Fill="#7C8DFF" />
                <Ellipse x:Name="OrbCore"
                         Width="88"
                         Height="88"
                         Opacity="0.96"
                         RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <ScaleTransform x:Name="OrbScale" ScaleX="1" ScaleY="1" />
                    </Ellipse.RenderTransform>
                    <Ellipse.Fill>
                        <RadialGradientBrush Center="0.38,0.32" GradientOrigin="0.38,0.32" RadiusX="0.7" RadiusY="0.7">
                            <GradientStop x:Name="CenterStop" Color="#FFF7F9FF" Offset="0" />
                            <GradientStop x:Name="MidStop" Color="#FFB8C8FF" Offset="0.55" />
                            <GradientStop x:Name="EdgeStop" Color="#FF6D7CFF" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse Width="66"
                         Height="66"
                         Margin="-12,-16,0,0"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Fill="#16FFFFFF" />
                <Ellipse x:Name="OrbRing"
                         Width="54"
                         Height="54"
                         StrokeThickness="2"
                         Stroke="#BFFFFFFF"
                         Opacity="0.9" />
                <TextBlock x:Name="StateGlyph"
                           Text="•"
                           FontSize="32"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="White" />
            </Grid>
        </Button>

        <Border x:Name="Panel"
                Grid.Column="1"
                Width="0"
                Height="420"
                Margin="12,0,0,0"
                CornerRadius="26"
                Background="#E0141720"
                BorderBrush="#30FFFFFF"
                BorderThickness="1"
                Opacity="0"
                Visibility="Collapsed"
                SizeChanged="Panel_SizeChanged">
            <Border.Transitions>
                <TransitionCollection>
                    <RepositionThemeTransition />
                </TransitionCollection>
            </Border.Transitions>

            <Grid Padding="16" RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" ColumnSpacing="7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock x:Name="IdentityText"
                                   Text="BabyAI"
                                   FontSize="21"
                                   FontWeight="SemiBold"
                                   Foreground="#FFF8FAFF" />
                        <TextBlock x:Name="TaskText"
                                   Text="Нет активной задачи"
                                   FontSize="11"
                                   Foreground="#9FFFFFFF"
                                   TextWrapping="Wrap"
                                   MaxLines="1" />
                    </StackPanel>

                    <Border Grid.Column="1"
                            VerticalAlignment="Top"
                            CornerRadius="13"
                            Padding="9,5"
                            Background="#18FFFFFF"
                            BorderBrush="#22FFFFFF"
                            BorderThickness="1">
                        <TextBlock x:Name="BrainText"
                                   Text="Brain: checking…"
                                   FontSize="10"
                                   Foreground="#DFFFFFFF"
                                   MaxWidth="128"
                                   TextTrimming="CharacterEllipsis" />
                    </Border>

                    <Button x:Name="DetailsButton"
                            Grid.Column="2"
                            Width="28"
                            Height="28"
                            Padding="0"
                            CornerRadius="14"
                            Content="⋯"
                            FontSize="17"
                            VerticalAlignment="Top"
                            Click="DetailsButton_Click"
                            ToolTipService.ToolTip="Диагностика" />

                    <Button Grid.Column="3"
                            Width="28"
                            Height="28"
                            Padding="0"
                            CornerRadius="14"
                            Content="‹"
                            FontSize="18"
                            VerticalAlignment="Top"
                            Click="OrbButton_Click"
                            ToolTipService.ToolTip="Свернуть" />
                </Grid>

                <Border Grid.Row="1"
                        Background="#12FFFFFF"
                        BorderBrush="#18FFFFFF"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="10,7">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid x:Name="ReplyActivityIndicator"
                              Grid.Column="0"
                              Width="14"
                              Height="14"
                              Visibility="Collapsed"
                              VerticalAlignment="Center">
                            <Ellipse Width="12"
                                     Height="12"
                                     Stroke="#BFFFFFFF"
                                     StrokeThickness="2" />
                            <Ellipse Width="4"
                                     Height="4"
                                     Fill="#FFF8FAFF" />
                        </Grid>
                        <TextBlock x:Name="ReplyText"
                                   Grid.Column="1"
                                   Text="Готов к разговору."
                                   TextWrapping="Wrap"
                                   FontSize="11"
                                   Foreground="#AFFFFFFF"
                                   VerticalAlignment="Center" />
                        <Button x:Name="RetryButton"
                                Grid.Column="2"
                                Content="Повторить"
                                FontSize="11"
                                Padding="10,4"
                                CornerRadius="10"
                                Click="RetryButton_Click"
                                Visibility="Collapsed" />
                    </Grid>
                </Border>

                <Border Grid.Row="2"
                        Background="#0BFFFFFF"
                        BorderBrush="#12FFFFFF"
                        BorderThickness="1"
                        CornerRadius="18"
                        Padding="10,10,6,10">
                    <ScrollViewer x:Name="ConversationScroller"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="ConversationStack"
                                    Padding="1,2,5,2"
                                    Spacing="2" />
                    </ScrollViewer>
                </Border>

                <Border Grid.Row="3"
                        Background="#16FFFFFF"
                        BorderBrush="#24FFFFFF"
                        BorderThickness="1"
                        CornerRadius="18"
                        Padding="10,7,7,7">
                    <Grid ColumnSpacing="7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="MessageBox"
                                 Grid.Column="0"
                                 PlaceholderText="Напиши BabyAI..."
                                 AcceptsReturn="True"
                                 MinHeight="44"
                                 MaxHeight="88"
                                 Padding="2,7"
                                 TextWrapping="Wrap"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="#FFF8FAFF"
                                 KeyDown="MessageBox_KeyDown" />

                        <Button x:Name="SendButton"
                                Grid.Column="1"
                                Width="42"
                                Height="42"
                                Padding="0"
                                CornerRadius="21"
                                Content="↑"
                                FontSize="20"
                                FontWeight="SemiBold"
                                Click="SendButton_Click"
                                ToolTipService.ToolTip="Отправить · Enter" />
                        <Button x:Name="StopButton"
                                Grid.Column="2"
                                Width="42"
                                Height="42"
                                Padding="0"
                                CornerRadius="21"
                                Content="■"
                                FontSize="13"
                                Click="StopButton_Click"
                                ToolTipService.ToolTip="Остановить"
                                Visibility="Collapsed" />
                    </Grid>
                </Border>

                <Grid Grid.Row="4" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="ApproveButton"
                            Grid.Column="0"
                            Content="Сохранить"
                            CornerRadius="12"
                            Click="ApproveButton_Click"
                            Visibility="Collapsed" />
                    <Button x:Name="RejectButton"
                            Grid.Column="1"
                            Content="Отклонить"
                            CornerRadius="12"
                            Click="RejectButton_Click"
                            Visibility="Collapsed" />
                </Grid>

                <TextBlock x:Name="ConversationText"
                           Text="Чат готов. Напиши первое сообщение ниже."
                           Visibility="Collapsed" />

                <StackPanel Visibility="Collapsed">
                    <TextBlock x:Name="CoreStatusText" Text="Core: not checked" />
                    <TextBlock x:Name="RuntimeText" Text="Runtime: unknown" />
                    <TextBlock x:Name="StartupText" Text="Startup: checking…" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
