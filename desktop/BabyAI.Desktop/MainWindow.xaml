<Window
    x:Class="BabyAI.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="Root" Loaded="Root_Loaded_WithToolApproval" Background="#FF0E1016" RequestedTheme="Dark" Padding="10">
        <Grid.Resources>
            <!-- Shared interaction palette keeps the native focus and disabled states. -->
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#24AAB8FF" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#347F91E8" />
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#50B6C2FF" />
            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#708F9FE8" />
            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FFE1E6FF" />
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
            <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#FFF8FAFF" />
            <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#FFA0A6B8" />
            <Style x:Key="IconButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#0CFFFFFF" />
                <Setter Property="BorderBrush" Value="#1CFFFFFF" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="#F6FFFFFF" />
            </Style>
            <Style x:Key="PrimaryCircleButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#FFF2F4FF" />
                <Setter Property="BorderBrush" Value="#55FFFFFF" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="#FF11131A" />
            </Style>
            <Style x:Key="NavigationButtonStyle" TargetType="Button">
                <Setter Property="MinHeight" Value="42" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="Padding" Value="10,8" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="#E8FFFFFF" />
            </Style>
        </Grid.Resources>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition x:Name="PanelColumn" Width="0" />
        </Grid.ColumnDefinitions>

        <Grid x:Name="OrbDock" Grid.Column="0" VerticalAlignment="Top">
        <Button x:Name="OrbButton"
                Grid.Column="0"
                Width="112"
                Height="112"
                CornerRadius="56"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Click="OrbButton_Click"
                PointerPressed="OrbButton_PointerPressed"
                PointerMoved="OrbButton_PointerMoved"
                PointerReleased="OrbButton_PointerReleased"
                PointerCaptureLost="OrbButton_PointerCaptureLost"
                Padding="0"
                Background="Transparent"
                BorderBrush="#26FFFFFF"
                BorderThickness="1">
            <Viewbox x:Name="OrbViewbox" Width="112" Height="112">
            <Grid x:Name="OrbArtwork" Width="112" Height="112">
                <Ellipse Width="110" Height="110" Fill="#130B0D13" Stroke="#24FFFFFF" StrokeThickness="1" />
                <Ellipse x:Name="OrbGlow" Width="106" Height="106" Opacity="0.34" Fill="#697CFF" />
                <Ellipse Width="98" Height="98" Opacity="0.45">
                    <Ellipse.Fill>
                        <RadialGradientBrush Center="0.5,0.5" RadiusX="0.6" RadiusY="0.6">
                            <GradientStop Color="#557F8CFF" Offset="0" />
                            <GradientStop Color="#006F74FF" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse x:Name="OrbCore"
                         Width="84"
                         Height="84"
                         Opacity="0.98"
                         RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <ScaleTransform x:Name="OrbScale" ScaleX="1" ScaleY="1" />
                    </Ellipse.RenderTransform>
                    <Ellipse.Fill>
                        <RadialGradientBrush Center="0.35,0.3" GradientOrigin="0.32,0.27" RadiusX="0.78" RadiusY="0.78">
                            <GradientStop x:Name="CenterStop" Color="#FFFDFEFF" Offset="0" />
                            <GradientStop x:Name="MidStop" Color="#FFC7D1FF" Offset="0.46" />
                            <GradientStop x:Name="EdgeStop" Color="#FF6673FF" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse Width="62" Height="42" Margin="-18,-24,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="#1FFFFFFF" />
                <Ellipse x:Name="OrbRing" Width="54" Height="54" StrokeThickness="1.5" Stroke="#CFFFFFFF" Opacity="0.88" />
                <TextBlock x:Name="StateGlyph"
                           Text="•"
                           FontSize="30"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="White" />
            </Grid>
            </Viewbox>
        </Button>
        </Grid>

        <Border x:Name="Panel"
                Grid.Column="1"
                Width="0"
                Height="420"
                Margin="0"
                CornerRadius="20"
                Background="#E60E1016"
                BorderBrush="Transparent"
                BorderThickness="0"
                Opacity="0"
                Visibility="Collapsed"
                SizeChanged="Panel_SizeChanged">
            <Border.Transitions>
                <TransitionCollection>
                    <RepositionThemeTransition />
                </TransitionCollection>
            </Border.Transitions>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="NavigationColumn" Width="224" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Row="0" Grid.ColumnSpan="2" Height="56" Margin="8,0,6,0" ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid x:Name="HeaderOrbHost" Width="40" Height="40" VerticalAlignment="Center" />
                    <Border x:Name="WindowDragHandle" Grid.Column="1" Background="Transparent"
                            PointerPressed="WindowDragHandle_PointerPressed"
                            ToolTipService.ToolTip="Перетащи окно · двойной щелчок — развернуть">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="4,0,0,0">
                            <TextBlock Text="UNIX" FontSize="14" FontWeight="SemiBold" CharacterSpacing="90" Foreground="#FFF0F2FF" />
                            <TextBlock Text="Личный помощник" FontSize="11" Foreground="#FF929BB2" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Button Width="36" Height="32" CornerRadius="10" Padding="0"
                                Style="{StaticResource IconButtonStyle}" Click="OrbButton_Click"
                                AutomationProperties.Name="Компактный орб" ToolTipService.ToolTip="Компактный орб">
                            <Ellipse Width="13" Height="13" Stroke="#FFBDC8FF" StrokeThickness="1.5" Fill="#287C8DFF" />
                        </Button>
                        <Button Width="36" Height="32" CornerRadius="10" Padding="0"
                                Style="{StaticResource IconButtonStyle}" Click="WindowMinimize_Click"
                                AutomationProperties.Name="Свернуть окно" ToolTipService.ToolTip="Свернуть на панель задач">
                            <FontIcon Glyph="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="12" />
                        </Button>
                        <Button x:Name="WindowMaximizeButton" Width="36" Height="32" CornerRadius="10" Padding="0"
                                Style="{StaticResource IconButtonStyle}" Click="WindowMaximize_Click"
                                AutomationProperties.Name="Развернуть окно" ToolTipService.ToolTip="Развернуть на весь экран">
                            <FontIcon x:Name="WindowMaximizeIcon" Glyph="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="12" />
                        </Button>
                        <Button Width="36" Height="32" CornerRadius="10" Padding="0"
                                Style="{StaticResource IconButtonStyle}" Click="WindowHide_Click"
                                AutomationProperties.Name="Скрыть в области уведомлений" ToolTipService.ToolTip="Скрыть в области уведомлений · UNIX продолжит работу">
                            <FontIcon Glyph="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="12" />
                        </Button>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" CornerRadius="20" Opacity="0.35">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#162B3350" Offset="0" />
                            <GradientStop Color="#00131822" Offset="0.45" />
                            <GradientStop Color="#161C1830" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <Border x:Name="NavigationSurface" Grid.Row="1" Grid.Column="0"
                        Margin="8"
                        Padding="4,8"
                        CornerRadius="16"
                        Background="#4807080D"
                        BorderBrush="#12FFFFFF"
                        BorderThickness="1">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Height="38" ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        VerticalAlignment="Center">
                                <Border x:Name="NavigationBrandMark"
                                        Width="26"
                                        Height="26"
                                        CornerRadius="9"
                                        Background="#257C8DFF"
                                        BorderBrush="#38A2AEFF"
                                        BorderThickness="1">
                                    <TextBlock Text="✦"
                                               FontSize="12"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <TextBlock x:Name="NavigationHeaderLabel"
                                           Text="UNIX"
                                           Foreground="#FFC0C6D8"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           CharacterSpacing="45"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <Button x:Name="NavigationToggleButton"
                                    Grid.Column="1"
                                    Width="34"
                                    Height="34"
                                    Padding="0"
                                    CornerRadius="10"
                                    Content="&#xE76B;"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="12"
                                    Style="{StaticResource IconButtonStyle}"
                                    Click="NavigationToggleButton_Click"
                                    AutomationProperties.Name="Свернуть навигацию"
                                    ToolTipService.ToolTip="Свернуть навигацию" />
                        </Grid>

                        <Button x:Name="NewChatButton"
                                Grid.Row="1"
                                Style="{StaticResource NavigationButtonStyle}"
                                Click="NewChatButton_Click"
                                AutomationProperties.Name="Новый чат"
                                ToolTipService.ToolTip="Новый чат">
                            <StackPanel Orientation="Horizontal" Spacing="11">
                                <FontIcon Glyph="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="24" VerticalAlignment="Center" />
                                <TextBlock x:Name="NewChatLabel"
                                           Text="Новый чат"
                                           FontSize="13"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <ScrollViewer Grid.Row="2"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Spacing="5">
                                <TextBlock x:Name="ProjectsSectionLabel"
                                           Text="ПРОЕКТЫ"
                                           Margin="11,10,0,3"
                                           FontSize="9"
                                           CharacterSpacing="110"
                                           Foreground="#FFA0A6B8" />
                                <StackPanel x:Name="WorkspaceItems" Spacing="3" />
                                <TextBlock x:Name="ProjectNameText" Visibility="Collapsed" />
                                <TextBlock x:Name="RecentsSectionLabel"
                                           Text="НЕДАВНИЕ"
                                           Margin="11,13,0,3"
                                           FontSize="9"
                                           CharacterSpacing="110"
                                           Foreground="#FFA0A6B8" />
                                <StackPanel x:Name="RecentChatItems" Spacing="3" />
                                <TextBlock x:Name="HistoryModeText" FontSize="10" Foreground="#FFA0A6B8" TextWrapping="Wrap" Margin="10,6" />
                                <Button x:Name="CurrentChatButton" Visibility="Collapsed" />
                                <TextBlock x:Name="RecentNameText" Visibility="Collapsed" />
                            </StackPanel>
                        </ScrollViewer>

                        <StackPanel Grid.Row="3" Spacing="3">
                            <Rectangle Height="1" Margin="7,1,7,5" Fill="#18FFFFFF" />
                            <Button x:Name="ProfileButton"
                                    Style="{StaticResource NavigationButtonStyle}"
                                    AutomationProperties.Name="Локальный профиль" ToolTipService.ToolTip="Локальный профиль">
                                <StackPanel Orientation="Horizontal" Spacing="11">
                                    <Border Width="24" Height="24" CornerRadius="12" Background="#287C8DFF">
                                        <TextBlock Text="U" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel x:Name="ProfileLabel" VerticalAlignment="Center">
                                        <TextBlock Text="Локальный профиль" FontSize="12" />
                                        <TextBlock Text="На этом устройстве" FontSize="9" Foreground="#FFA0A6B8" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                            <Button x:Name="GingerNavigationButton"
                                    Style="{StaticResource NavigationButtonStyle}"
                                    Click="AgentsNavigationButton_Click"
                                    AutomationProperties.Name="Агенты"
                                    ToolTipService.ToolTip="Агенты UNIX">
                                <StackPanel Orientation="Horizontal" Spacing="11">
                                    <FontIcon Glyph="&#xE8D4;" FontFamily="Segoe MDL2 Assets"
                                              FontSize="16" Width="24" VerticalAlignment="Center" />
                                    <TextBlock x:Name="GingerNavigationLabel"
                                               Text="Агенты" FontSize="12"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="SettingsNavigationButton"
                                    Style="{StaticResource NavigationButtonStyle}"
                                    Click="SettingsButton_Click"
                                    AutomationProperties.Name="Настройки" ToolTipService.ToolTip="Настройки">
                                <StackPanel Orientation="Horizontal" Spacing="11">
                                    <FontIcon Glyph="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="24" VerticalAlignment="Center" />
                                    <TextBlock x:Name="SettingsNavigationLabel" Text="Настройки" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="VoiceNavigationButton"
                                    Style="{StaticResource NavigationButtonStyle}"
                                    Click="VoiceButton_Click"
                                    IsEnabled="{Binding IsEnabled, ElementName=SendButton}"
                                    AutomationProperties.Name="Голос" ToolTipService.ToolTip="Голос">
                                <StackPanel Orientation="Horizontal" Spacing="11">
                                    <FontIcon Glyph="&#xE720;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="24" VerticalAlignment="Center" />
                                    <TextBlock x:Name="VoiceNavigationLabel" Text="Голос" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Grid.Column="1" Padding="18,10,18,18" RowSpacing="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="3">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <Ellipse Width="7" Height="7" Fill="#FF8F9CFF" VerticalAlignment="Center" />
                                <TextBlock Text="Чат"
                                           FontSize="19"
                                           FontWeight="SemiBold"
                                           CharacterSpacing="35"
                                           Foreground="#FFF7F8FC" />
                                <TextBlock x:Name="IdentityText" Text="BabyAI" Visibility="Collapsed" />
                            </StackPanel>
                            <TextBlock x:Name="TaskText"
                                       Text="Нет активной задачи"
                                       FontSize="11"
                                       Foreground="#FFA0A6B8"
                                       TextWrapping="Wrap"
                                       MaxLines="1" />
                        </StackPanel>

                        <Button x:Name="DetailsButton"
                                Grid.Column="1"
                                Width="32"
                                Height="32"
                                Padding="0"
                                CornerRadius="16"
                                Content="&#xE712;"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="17"
                                Style="{StaticResource IconButtonStyle}"
                                VerticalAlignment="Top"
                                Click="DetailsButton_Click"
                                ToolTipService.ToolTip="Диагностика" />

                    </Grid>

                    <Grid Grid.Row="1" ColumnSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                CornerRadius="13"
                                Padding="8,5"
                                Background="#13FFFFFF">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Grid x:Name="ReplyActivityIndicator" Width="12" Height="12" Visibility="Collapsed" VerticalAlignment="Center">
                                    <Ellipse Width="10" Height="10" Stroke="#9FFFFFFF" StrokeThickness="1.5" />
                                    <Ellipse Width="3" Height="3" Fill="#FFF7F8FC" />
                                </Grid>
                                <Ellipse Width="6" Height="6" Fill="#FF78D59A" VerticalAlignment="Center" />
                                <TextBlock x:Name="BrainText"
                                           Text="Brain: checking…"
                                           FontSize="10"
                                           Foreground="#BDFFFFFF"
                                           MaxWidth="118"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="ReplyText"
                                   Grid.Column="1"
                                   Text="Готов к разговору."
                                   TextWrapping="Wrap"
                                   FontSize="11"
                                   Foreground="#FFADB3C3"
                                   VerticalAlignment="Center" />

                        <Button x:Name="RetryButton"
                                Grid.Column="2"
                                Content="Повторить"
                                FontSize="10"
                                Padding="10,5"
                                CornerRadius="11"
                                Style="{StaticResource IconButtonStyle}"
                                Click="RetryButton_Click"
                                Visibility="Collapsed" />
                        <Button x:Name="GingerDeferredButton"
                                Grid.Row="1" Grid.ColumnSpan="3"
                                Margin="0,8,0,0" Padding="10,6" CornerRadius="11"
                                HorizontalAlignment="Left"
                                Style="{StaticResource IconButtonStyle}"
                                IsEnabled="{Binding IsEnabled, ElementName=SendButton}"
                                Loaded="GingerDeferredButton_Loaded"
                                Click="GingerDeferredButton_Click"
                                AutomationProperties.Name="Отложенные позиции">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Отложенные позиции" FontSize="11" VerticalAlignment="Center" />
                                <Border Background="#257C8DFF" CornerRadius="8" MinWidth="22" Padding="5,1">
                                    <TextBlock x:Name="GingerDeferredCount" Text="…" FontSize="10"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Border Grid.Row="2"
                            Background="#05000000"
                            CornerRadius="19"
                            Padding="4,8,2,8">
                        <ScrollViewer x:Name="ConversationScroller"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Spacing="8">
                                <StackPanel x:Name="ConversationStack"
                                            Padding="2,2,6,2"
                                            Spacing="4" />
                                <Border x:Name="GingerChatActivity" Visibility="Collapsed"
                                        Background="#141D2437" CornerRadius="12" Padding="12">
                                    <StackPanel Orientation="Horizontal" Spacing="9">
                                        <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                            <Ellipse x:Name="GingerStepDot1" Width="5" Height="5" Fill="#FF8F9CFF" />
                                            <Ellipse x:Name="GingerStepDot2" Width="5" Height="5" Fill="#FF8F9CFF" />
                                            <Ellipse x:Name="GingerStepDot3" Width="5" Height="5" Fill="#FF8F9CFF" />
                                        </StackPanel>
                                        <TextBlock x:Name="GingerChatStageText" Text="Агент Ginger"
                                                   FontSize="12" TextWrapping="Wrap" MaxWidth="320"
                                                   AutomationProperties.LiveSetting="Polite" />
                                    </StackPanel>
                                </Border>
                                <Border x:Name="GingerChatConfirmationCard" Visibility="Collapsed"
                                        Background="#141D2437" CornerRadius="12" Padding="12">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="Проверка пары Ginger" FontWeight="SemiBold" />
                                        <TextBlock x:Name="GingerChatPairText" TextWrapping="Wrap"
                                                   IsTextSelectionEnabled="True" />
                                        <TextBlock Text="Проверь полные названия. Подтверждение разрешает одну привязку в открытом прайсе."
                                                   FontSize="12" TextWrapping="Wrap" />
                                        <Button x:Name="GingerChatConfirmButton" Content="Сопоставить эту пару"
                                                Click="GingerChatConfirm_Click" />
                                        <Button x:Name="GingerChatRejectButton" Content="Отклонить пару"
                                                Click="GingerChatReject_Click" />
                                    </StackPanel>
                                </Border>
                                <Expander x:Name="GingerBottleCard" Visibility="Collapsed"
                                          Header="Флакон и упаковка — интернет-проверка" HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch">
                                    <StackPanel Spacing="10">
                                        <TextBox x:Name="GingerBottleQuery" Header="Название для поиска" MaxLength="240" />
                                        <TextBox x:Name="GingerBottleUrl" Header="Ссылка на страницу, если уже есть" MaxLength="2048" PlaceholderText="https://…" />
                                        <TextBlock Text="В интернет уйдёт только указанное название. Фотографии и описания не подтверждают автоматически соответствие товару."
                                                   FontSize="12" TextWrapping="Wrap" />
                                        <Button x:Name="GingerBottleSearchButton" Content="Найти флакон в интернете" Click="GingerBottleSearch_Click" />
                                        <TextBlock x:Name="GingerBottleStatus" TextWrapping="Wrap" IsTextSelectionEnabled="True" AutomationProperties.LiveSetting="Polite" />
                                        <StackPanel x:Name="GingerBottleSources" Spacing="18" />
                                    </StackPanel>
                                </Expander>
                                <Expander x:Name="GingerChatReviewCard" Visibility="Collapsed"
                                          Header="Оценить ответ UNIX" HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch">
                                    <StackPanel Spacing="10">
                                        <TextBlock x:Name="GingerChatReviewSource" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                        <ComboBox x:Name="GingerChatScore" Header="Оценка ответа от 0 до 10"
                                                  PlaceholderText="Выбери оценку" HorizontalAlignment="Stretch" />
                                        <TextBox x:Name="GingerChatFeedback" Header="Пояснение к оценке / причина отзыва"
                                                 MaxLength="4000" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" MaxHeight="160" />
                                        <Button x:Name="GingerChatRateButton" Content="Сохранить оценку ответа" Click="GingerChatRate_Click" />
                                        <Button x:Name="GingerChatRevokeRatingButton" Content="Отозвать оценку" Click="GingerChatRevokeRating_Click" />
                                        <TextBlock x:Name="GingerChatRatingStatus" TextWrapping="Wrap" FontSize="12" AutomationProperties.LiveSetting="Polite" />
                                    </StackPanel>
                                </Expander>
                                <Expander x:Name="GingerChatLessonCard" Visibility="Collapsed"
                                          Header="Объяснить UNIX" HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch">
                                    <StackPanel Spacing="10">
                                        <TextBlock x:Name="GingerChatLessonSource" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                        <TextBlock x:Name="GingerChatSavedLesson" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                        <ComboBox x:Name="GingerChatLessonSelector" Header="Объяснения поставщика" HorizontalAlignment="Stretch"
                                                  SelectionChanged="GingerChatLessonSelector_Changed" />
                                        <TextBlock Text="Новое объяснение добавляется к действующим. Для исправления или отзыва выбери отдельный урок. При проверке UNIX учитывает их вместе."
                                                   TextWrapping="Wrap" FontSize="12" />
                                        <TextBox x:Name="GingerChatLessonText" Header="Твоё объяснение"
                                                 MaxLength="4000" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" MaxHeight="160"
                                                 TextChanged="GingerChatLessonText_Changed" />
                                        <Button x:Name="GingerChatPreviewLessonButton" Content="Проверить понимание" Click="GingerChatPreviewLesson_Click" />
                                        <TextBox x:Name="GingerChatLessonPreview" Header="Как UNIX понял объяснение"
                                                 IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="200" />
                                        <Button x:Name="GingerChatSaveLessonButton" Content="Понимание верно — сохранить урок" Click="GingerChatSaveLesson_Click" />
                                        <Button x:Name="GingerChatRevokeLessonButton" Content="Отозвать выбранный урок" Click="GingerChatRevokeLesson_Click" />
                                        <TextBlock x:Name="GingerChatLessonStatus" TextWrapping="Wrap" FontSize="12" AutomationProperties.LiveSetting="Polite" />
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <Border Grid.Row="3"
                            Background="#141D2437"
                            BorderBrush="#3D8997BE"
                            BorderThickness="1"
                            CornerRadius="20"
                            Padding="14,8,8,8">
                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="MessageBox"
                                     Grid.Column="0"
                                     PlaceholderText="Спроси UNIX…"
                                     FontSize="14"
                                     AcceptsReturn="True"
                                     MinHeight="44"
                                     MaxHeight="88"
                                     Padding="0,7"
                                     TextWrapping="Wrap"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="#FFF8FAFF"
                                     KeyDown="MessageBox_KeyDown" />

                            <Button x:Name="VoiceButton"
                                    Grid.Column="1"
                                    Width="40"
                                    Height="40"
                                    Padding="0"
                                    CornerRadius="20"
                                    Content="&#xE720;"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="16"
                                    Style="{StaticResource IconButtonStyle}"
                                    Click="VoiceButton_Click"
                                    IsEnabled="{Binding IsEnabled, ElementName=SendButton}"
                                    AutomationProperties.Name="Голосовой ввод"
                                    VerticalAlignment="Bottom"
                                    ToolTipService.ToolTip="Голосовой ввод" />

                            <Button x:Name="SendButton"
                                    Grid.Column="2"
                                    Width="40"
                                    Height="40"
                                    Padding="0"
                                    CornerRadius="20"
                                    FontSize="20"
                                    FontWeight="SemiBold"
                                    Style="{StaticResource PrimaryCircleButtonStyle}"
                                    VerticalAlignment="Bottom"
                                    Click="SendButton_Click"
                                    ToolTipService.ToolTip="Отправить · Enter">
                                <Path Data="M 1,7 L 7,1 L 13,7 M 7,1 L 7,15"
                                      Stroke="#FF11131A" StrokeThickness="1.8" Width="14" Height="16" />
                            </Button>

                            <Button x:Name="StopButton"
                                    Grid.Column="3"
                                    Width="40"
                                    Height="40"
                                    Padding="0"
                                    CornerRadius="20"
                                    FontSize="12"
                                    Style="{StaticResource IconButtonStyle}"
                                    Click="StopButton_Click"
                                    VerticalAlignment="Bottom"
                                    ToolTipService.ToolTip="Остановить"
                                    Visibility="Collapsed">
                                <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="#FFF2F4FF" />
                            </Button>
                        </Grid>
                    </Border>

                    <Border x:Name="ApprovalCard"
                            Grid.Row="4"
                            Background="#1CF3B95F"
                            BorderBrush="#4CF3C676"
                            BorderThickness="1"
                            CornerRadius="17"
                            Padding="12,10"
                            Visibility="Collapsed">
                        <Grid RowSpacing="9">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Spacing="3">
                                <TextBlock Text="ТРЕБУЕТСЯ РАЗРЕШЕНИЕ"
                                           FontSize="9"
                                           CharacterSpacing="110"
                                           Foreground="#FFF5D59B" />
                                <TextBlock x:Name="ApprovalDescriptionText"
                                           Text="UNIX приостановил локальное действие до вашего решения."
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Foreground="#DFFFFFFF" />
                            </StackPanel>
                            <Grid Grid.Row="1" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="ApproveButton"
                                        Grid.Column="0"
                                        Content="Разрешить один раз"
                                        CornerRadius="12"
                                        Click="ApproveButton_Click" />
                                <Button x:Name="RejectButton"
                                        Grid.Column="1"
                                        Content="Отклонить"
                                        CornerRadius="12"
                                        Click="RejectButton_Click" />
                            </Grid>
                        </Grid>
                    </Border>

                    <TextBlock x:Name="ConversationText"
                               Text="Чат готов. Напиши первое сообщение ниже."
                               Visibility="Collapsed" />

                    <StackPanel Visibility="Collapsed">
                        <TextBlock x:Name="CoreStatusText" Text="Core: not checked" />
                        <TextBlock x:Name="RuntimeText" Text="Runtime: unknown" />
                        <TextBlock x:Name="StartupText" Text="Startup: checking…" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
