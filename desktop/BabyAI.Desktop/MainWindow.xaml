<Window
    x:Class="BabyAI.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="Root" Background="Transparent" Padding="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition x:Name="PanelColumn" Width="0" />
        </Grid.ColumnDefinitions>

        <Button x:Name="OrbButton"
                Grid.Column="0"
                Width="112"
                Height="112"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Click="OrbButton_Click"
                PointerPressed="OrbButton_PointerPressed"
                PointerMoved="OrbButton_PointerMoved"
                PointerReleased="OrbButton_PointerReleased"
                Padding="0"
                Background="Transparent"
                BorderThickness="0">
            <Grid>
                <Ellipse x:Name="OrbGlow"
                         Width="104"
                         Height="104"
                         Opacity="0.28"
                         Fill="#7C8DFF" />
                <Ellipse x:Name="OrbCore"
                         Width="88"
                         Height="88"
                         Opacity="0.96">
                    <Ellipse.RenderTransform>
                        <ScaleTransform x:Name="OrbScale" ScaleX="1" ScaleY="1" />
                    </Ellipse.RenderTransform>
                    <Ellipse.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop x:Name="CenterStop" Color="#FFF7F9FF" Offset="0" />
                            <GradientStop x:Name="MidStop" Color="#FFB8C8FF" Offset="0.55" />
                            <GradientStop x:Name="EdgeStop" Color="#FF6D7CFF" Offset="1" />
                        </LinearGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse x:Name="OrbRing"
                         Width="54"
                         Height="54"
                         StrokeThickness="2"
                         Stroke="#BFFFFFFF"
                         Opacity="0.9" />
                <TextBlock x:Name="StateGlyph"
                           Text="•"
                           FontSize="32"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="White" />
            </Grid>
        </Button>

        <Border x:Name="Panel"
                Grid.Column="1"
                Width="0"
                Height="420"
                Margin="12,0,0,0"
                Background="#E0141720"
                BorderBrush="#30FFFFFF"
                BorderThickness="1"
                Opacity="0"
                Visibility="Collapsed"
                SizeChanged="Panel_SizeChanged">
            <Grid Padding="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="IdentityText"
                                   Text="BabyAI"
                                   FontSize="21"
                                   Foreground="#FFF8FAFF" />
                        <TextBlock x:Name="TaskText"
                                   Text="Нет активной задачи"
                                   FontSize="11"
                                   Foreground="#9FFFFFFF"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <Border Grid.Column="1"
                            Margin="8,0,0,0"
                            VerticalAlignment="Top"
                            Padding="9,5"
                            Background="#18FFFFFF"
                            BorderBrush="#22FFFFFF"
                            BorderThickness="1">
                        <TextBlock x:Name="BrainText"
                                   Text="Brain: checking…"
                                   FontSize="10"
                                   Foreground="#DFFFFFFF"
                                   MaxWidth="128" />
                    </Border>

                    <Button x:Name="DetailsButton"
                            Grid.Column="2"
                            Width="28"
                            Height="28"
                            Margin="7,0,0,0"
                            Padding="0"
                            Content="⋯"
                            FontSize="17"
                            VerticalAlignment="Top"
                            Click="DetailsButton_Click" />

                    <Button Grid.Column="3"
                            Width="28"
                            Height="28"
                            Margin="7,0,0,0"
                            Padding="0"
                            Content="‹"
                            FontSize="18"
                            VerticalAlignment="Top"
                            Click="OrbButton_Click" />
                </Grid>

                <Border Grid.Row="1"
                        Margin="0,0,0,10"
                        Background="#12FFFFFF"
                        BorderBrush="#18FFFFFF"
                        BorderThickness="1"
                        Padding="10,7">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ProgressRing x:Name="ReplyActivityRing"
                                      Grid.Column="0"
                                      Width="14"
                                      Height="14"
                                      Margin="0,0,8,0"
                                      IsActive="False"
                                      Visibility="Collapsed"
                                      VerticalAlignment="Center" />
                        <TextBlock x:Name="ReplyText"
                                   Grid.Column="1"
                                   Text="Готов к разговору."
                                   TextWrapping="Wrap"
                                   FontSize="11"
                                   Foreground="#AFFFFFFF"
                                   VerticalAlignment="Center" />
                        <Button x:Name="RetryButton"
                                Grid.Column="2"
                                Margin="8,0,0,0"
                                Content="Повторить"
                                FontSize="11"
                                Padding="10,4"
                                Click="RetryButton_Click"
                                Visibility="Collapsed" />
                    </Grid>
                </Border>

                <Border Grid.Row="2"
                        Margin="0,0,0,10"
                        Background="#0BFFFFFF"
                        BorderBrush="#12FFFFFF"
                        BorderThickness="1"
                        Padding="10">
                    <ScrollViewer x:Name="ConversationScroller"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="ConversationStack" />
                    </ScrollViewer>
                </Border>

                <Border Grid.Row="3"
                        Margin="0,0,0,10"
                        Background="#16FFFFFF"
                        BorderBrush="#24FFFFFF"
                        BorderThickness="1"
                        Padding="10,7">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="MessageBox"
                                 Grid.Column="0"
                                 PlaceholderText="Напиши BabyAI..."
                                 AcceptsReturn="True"
                                 MinHeight="44"
                                 MaxHeight="88"
                                 TextWrapping="Wrap"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="#FFF8FAFF"
                                 KeyDown="MessageBox_KeyDown" />

                        <Button x:Name="SendButton"
                                Grid.Column="1"
                                Width="42"
                                Height="42"
                                Margin="7,0,0,0"
                                Padding="0"
                                Content="↑"
                                FontSize="20"
                                Click="SendButton_Click" />
                        <Button x:Name="StopButton"
                                Grid.Column="2"
                                Width="42"
                                Height="42"
                                Margin="7,0,0,0"
                                Padding="0"
                                Content="■"
                                FontSize="13"
                                Click="StopButton_Click"
                                Visibility="Collapsed" />
                    </Grid>
                </Border>

                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="ApproveButton"
                            Grid.Column="0"
                            Margin="0,0,4,0"
                            Content="Сохранить"
                            Click="ApproveButton_Click"
                            Visibility="Collapsed" />
                    <Button x:Name="RejectButton"
                            Grid.Column="1"
                            Margin="4,0,0,0"
                            Content="Отклонить"
                            Click="RejectButton_Click"
                            Visibility="Collapsed" />
                </Grid>

                <TextBlock x:Name="ConversationText"
                           Text="Чат готов. Напиши первое сообщение ниже."
                           Visibility="Collapsed" />

                <StackPanel Visibility="Collapsed">
                    <TextBlock x:Name="CoreStatusText" Text="Core: not checked" />
                    <TextBlock x:Name="RuntimeText" Text="Runtime: unknown" />
                    <TextBlock x:Name="StartupText" Text="Startup: checking…" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
