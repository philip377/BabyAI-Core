<Window
    x:Class="BabyAI.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="Root" Loaded="Root_Loaded_WithToolApproval" Background="Transparent" Padding="10">
        <Grid.Resources>
            <Style x:Key="IconButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#12FFFFFF" />
                <Setter Property="BorderBrush" Value="#20FFFFFF" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="#F6FFFFFF" />
            </Style>
            <Style x:Key="PrimaryCircleButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#FFF2F4FF" />
                <Setter Property="BorderBrush" Value="#55FFFFFF" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="#FF11131A" />
            </Style>
        </Grid.Resources>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition x:Name="PanelColumn" Width="0" />
        </Grid.ColumnDefinitions>

        <Button x:Name="OrbButton"
                Grid.Column="0"
                Width="112"
                Height="112"
                CornerRadius="56"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Click="OrbButton_Click"
                PointerPressed="OrbButton_PointerPressed"
                PointerMoved="OrbButton_PointerMoved"
                PointerReleased="OrbButton_PointerReleased"
                Padding="0"
                Background="Transparent"
                BorderBrush="#26FFFFFF"
                BorderThickness="1">
            <Grid>
                <Ellipse Width="110" Height="110" Fill="#130B0D13" Stroke="#24FFFFFF" StrokeThickness="1" />
                <Ellipse x:Name="OrbGlow" Width="106" Height="106" Opacity="0.34" Fill="#697CFF" />
                <Ellipse Width="98" Height="98" Opacity="0.45">
                    <Ellipse.Fill>
                        <RadialGradientBrush Center="0.5,0.5" RadiusX="0.6" RadiusY="0.6">
                            <GradientStop Color="#557F8CFF" Offset="0" />
                            <GradientStop Color="#006F74FF" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse x:Name="OrbCore"
                         Width="84"
                         Height="84"
                         Opacity="0.98"
                         RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <ScaleTransform x:Name="OrbScale" ScaleX="1" ScaleY="1" />
                    </Ellipse.RenderTransform>
                    <Ellipse.Fill>
                        <RadialGradientBrush Center="0.35,0.3" GradientOrigin="0.32,0.27" RadiusX="0.78" RadiusY="0.78">
                            <GradientStop x:Name="CenterStop" Color="#FFFDFEFF" Offset="0" />
                            <GradientStop x:Name="MidStop" Color="#FFC7D1FF" Offset="0.46" />
                            <GradientStop x:Name="EdgeStop" Color="#FF6673FF" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse Width="62" Height="42" Margin="-18,-24,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="#1FFFFFFF" />
                <Ellipse x:Name="OrbRing" Width="54" Height="54" StrokeThickness="1.5" Stroke="#CFFFFFFF" Opacity="0.88" />
                <TextBlock x:Name="StateGlyph"
                           Text="•"
                           FontSize="30"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="White" />
            </Grid>
        </Button>

        <Border x:Name="Panel"
                Grid.Column="1"
                Width="0"
                Height="420"
                Margin="6,0,0,0"
                CornerRadius="28"
                Background="#E60E1016"
                BorderBrush="#2BFFFFFF"
                BorderThickness="1"
                Opacity="0"
                Visibility="Collapsed"
                SizeChanged="Panel_SizeChanged">
            <Border.Transitions>
                <TransitionCollection>
                    <RepositionThemeTransition />
                </TransitionCollection>
            </Border.Transitions>

            <Grid>
                <Border CornerRadius="28" Opacity="0.35">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#162B3350" Offset="0" />
                            <GradientStop Color="#00131822" Offset="0.45" />
                            <GradientStop Color="#161C1830" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <Grid Padding="17,16,17,15" RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="3">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <Ellipse Width="7" Height="7" Fill="#FF8F9CFF" VerticalAlignment="Center" />
                                <TextBlock Text="UNIX"
                                           FontSize="21"
                                           FontWeight="SemiBold"
                                           CharacterSpacing="35"
                                           Foreground="#FFF7F8FC" />
                                <TextBlock x:Name="IdentityText" Text="BabyAI" Visibility="Collapsed" />
                            </StackPanel>
                            <TextBlock x:Name="TaskText"
                                       Text="Нет активной задачи"
                                       FontSize="11"
                                       Foreground="#8FFFFFFF"
                                       TextWrapping="Wrap"
                                       MaxLines="1" />
                        </StackPanel>

                        <Button x:Name="DetailsButton"
                                Grid.Column="1"
                                Width="30"
                                Height="30"
                                Padding="0"
                                CornerRadius="15"
                                Content="⋯"
                                FontSize="17"
                                Style="{StaticResource IconButtonStyle}"
                                VerticalAlignment="Top"
                                Click="DetailsButton_Click"
                                ToolTipService.ToolTip="Диагностика" />

                        <Button Grid.Column="2"
                                Width="30"
                                Height="30"
                                Padding="0"
                                CornerRadius="15"
                                Content="‹"
                                FontSize="18"
                                Style="{StaticResource IconButtonStyle}"
                                VerticalAlignment="Top"
                                Click="OrbButton_Click"
                                ToolTipService.ToolTip="Свернуть" />
                    </Grid>

                    <Grid Grid.Row="1" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                CornerRadius="13"
                                Padding="8,5"
                                Background="#13FFFFFF">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Grid x:Name="ReplyActivityIndicator" Width="12" Height="12" Visibility="Collapsed" VerticalAlignment="Center">
                                    <Ellipse Width="10" Height="10" Stroke="#9FFFFFFF" StrokeThickness="1.5" />
                                    <Ellipse Width="3" Height="3" Fill="#FFF7F8FC" />
                                </Grid>
                                <Ellipse Width="6" Height="6" Fill="#FF78D59A" VerticalAlignment="Center" />
                                <TextBlock x:Name="BrainText"
                                           Text="Brain: checking…"
                                           FontSize="10"
                                           Foreground="#BDFFFFFF"
                                           MaxWidth="118"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="ReplyText"
                                   Grid.Column="1"
                                   Text="Готов к разговору."
                                   TextWrapping="Wrap"
                                   FontSize="11"
                                   Foreground="#93FFFFFF"
                                   VerticalAlignment="Center" />

                        <Button x:Name="RetryButton"
                                Grid.Column="2"
                                Content="Повторить"
                                FontSize="10"
                                Padding="10,5"
                                CornerRadius="11"
                                Style="{StaticResource IconButtonStyle}"
                                Click="RetryButton_Click"
                                Visibility="Collapsed" />
                    </Grid>

                    <Border Grid.Row="2"
                            Background="#08000000"
                            CornerRadius="19"
                            Padding="10,10,6,10">
                        <ScrollViewer x:Name="ConversationScroller"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="ConversationStack"
                                        Padding="2,2,6,2"
                                        Spacing="4" />
                        </ScrollViewer>
                    </Border>

                    <Border Grid.Row="3"
                            Background="#18FFFFFF"
                            BorderBrush="#28FFFFFF"
                            BorderThickness="1"
                            CornerRadius="22"
                            Padding="12,6,6,6">
                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="MessageBox"
                                     Grid.Column="0"
                                     PlaceholderText="Спроси UNIX..."
                                     AcceptsReturn="True"
                                     MinHeight="44"
                                     MaxHeight="88"
                                     Padding="0,7"
                                     TextWrapping="Wrap"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="#FFF8FAFF"
                                     KeyDown="MessageBox_KeyDown" />

                            <Button x:Name="VoiceButton"
                                    Grid.Column="1"
                                    Width="40"
                                    Height="40"
                                    Padding="0"
                                    CornerRadius="20"
                                    Content="🎙"
                                    FontFamily="Segoe UI Emoji"
                                    FontSize="16"
                                    Style="{StaticResource IconButtonStyle}"
                                    Click="VoiceButton_Click"
                                    IsEnabled="{Binding IsEnabled, ElementName=SendButton}"
                                    AutomationProperties.Name="Голосовой ввод"
                                    ToolTipService.ToolTip="Голосовой ввод" />

                            <Button x:Name="SendButton"
                                    Grid.Column="2"
                                    Width="40"
                                    Height="40"
                                    Padding="0"
                                    CornerRadius="20"
                                    Content="↑"
                                    FontSize="20"
                                    FontWeight="SemiBold"
                                    Style="{StaticResource PrimaryCircleButtonStyle}"
                                    Click="SendButton_Click"
                                    ToolTipService.ToolTip="Отправить · Enter" />

                            <Button x:Name="StopButton"
                                    Grid.Column="3"
                                    Width="40"
                                    Height="40"
                                    Padding="0"
                                    CornerRadius="20"
                                    Content="■"
                                    FontSize="12"
                                    Style="{StaticResource IconButtonStyle}"
                                    Click="StopButton_Click"
                                    ToolTipService.ToolTip="Остановить"
                                    Visibility="Collapsed" />
                        </Grid>
                    </Border>

                    <Border x:Name="ApprovalCard"
                            Grid.Row="4"
                            Background="#1CF3B95F"
                            BorderBrush="#4CF3C676"
                            BorderThickness="1"
                            CornerRadius="17"
                            Padding="12,10"
                            Visibility="Collapsed">
                        <Grid RowSpacing="9">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Spacing="3">
                                <TextBlock Text="ТРЕБУЕТСЯ РАЗРЕШЕНИЕ"
                                           FontSize="9"
                                           CharacterSpacing="110"
                                           Foreground="#FFF5D59B" />
                                <TextBlock x:Name="ApprovalDescriptionText"
                                           Text="UNIX приостановил локальное действие до вашего решения."
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Foreground="#DFFFFFFF" />
                            </StackPanel>
                            <Grid Grid.Row="1" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="ApproveButton"
                                        Grid.Column="0"
                                        Content="Разрешить один раз"
                                        CornerRadius="12"
                                        Click="ApproveButton_Click" />
                                <Button x:Name="RejectButton"
                                        Grid.Column="1"
                                        Content="Отклонить"
                                        CornerRadius="12"
                                        Click="RejectButton_Click" />
                            </Grid>
                        </Grid>
                    </Border>

                    <TextBlock x:Name="ConversationText"
                               Text="Чат готов. Напиши первое сообщение ниже."
                               Visibility="Collapsed" />

                    <StackPanel Visibility="Collapsed">
                        <TextBlock x:Name="CoreStatusText" Text="Core: not checked" />
                        <TextBlock x:Name="RuntimeText" Text="Runtime: unknown" />
                        <TextBlock x:Name="StartupText" Text="Startup: checking…" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
